{
  "name": "wa-multi",
  "productName": "WA Multi",
  "version": "2.5.0",
  "description": "Multi-account WhatsApp Web desktop: instant tab-by-tab (or split) multi-account blast (personal & groups) with scheduling",
  "main": "index.js",
  "author": "Suki",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "id.mysuki.wamulti",
    "productName": "WA Multi",
    "icon": "build/icon.ico",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WA Multi"
    }
  },
  "dependencies": {
    "bytenode": "^1.7.0"
  }
}