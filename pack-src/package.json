{
  "name": "wa-multi",
  "productName": "WA Multi",
  "version": "2.6.2",
  "description": "Multi-account WhatsApp Web desktop: instant tab-by-tab (or split) multi-account blast (personal & groups) with scheduling",
  "main": "main.js",
  "author": "Suki",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "id.mysuki.wamulti",
    "productName": "WA Multi",
    "icon": "build/icon.ico",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/{test,__tests__,tests,example,examples,docs,doc}/**",
      "!node_modules/**/*.{md,map,ts,tsx}",
      "!node_modules/**/{.eslintrc,.editorconfig,.npmignore,.travis.yml}"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AdamRohdiHusni",
        "repo": "wa-multi",
        "releaseType": "release"
      }
    ],
    "artifactName": "WA-Multi-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WA Multi"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}